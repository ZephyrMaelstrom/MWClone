{
  "name": "@cc/server",
  "version": "0.0.1",
  "description": "Crucible Critters server-authoritative API",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-sqlite tsx watch src/index.ts",
    "start": "NODE_OPTIONS=--experimental-sqlite tsx src/index.ts",
    "test": "CC_DB_PATH=:memory: NODE_OPTIONS=--experimental-sqlite vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cc/engine": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
